#!/usr/bin/env bash
# Provision the Pages Functions' environment variables (production + preview):
#   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET  - from the GitHub OAuth App
#   ALLOWED_GITHUB_USERS                    - CMS login allowlist
#   SESSION_SECRET                          - freshly generated each run
#
# Re-running rotates SESSION_SECRET, which signs everyone out of /admin.
# Changes take effect on the next Pages deployment.
#
# Required env:
#   CLOUDFLARE_API_TOKEN        - token with Account:Cloudflare Pages:Edit
#   CLOUDFLARE_ACCOUNT_ID
#   CLOUDFLARE_PAGES_PROJECT    - e.g. "teacherwyatt"
#   GITHUB_CLIENT_ID
#   GITHUB_CLIENT_SECRET
#   ALLOWED_GITHUB_USERS        - comma-separated GitHub logins
set -Eeuo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}: line $LINENO: $BASH_COMMAND: exitcode $?"' ERR

: "${CLOUDFLARE_API_TOKEN:?must be set}"
: "${CLOUDFLARE_ACCOUNT_ID:?must be set}"
: "${CLOUDFLARE_PAGES_PROJECT:?must be set}"
: "${GITHUB_CLIENT_ID:?must be set}"
: "${GITHUB_CLIENT_SECRET:?must be set}"
: "${ALLOWED_GITHUB_USERS:?must be set}"

command -v openssl  >/dev/null || { echo >&2 "openssl not installed";  exit 1; }
command -v jq       >/dev/null || { echo >&2 "jq not installed";       exit 1; }

SESSION_SECRET="$(openssl rand -hex 32)"
echo "Generated new SESSION_SECRET (64 hex chars)."

echo "Writing environment variables to Pages project $CLOUDFLARE_PAGES_PROJECT ..."
# PATCH the project: env vars live under deployment_configs.<env>.env_vars.
# Setting `type: secret_text` encrypts the value at rest.
PAYLOAD=$(jq -n \
  --arg id "$GITHUB_CLIENT_ID" \
  --arg secret "$GITHUB_CLIENT_SECRET" \
  --arg session "$SESSION_SECRET" \
  --arg users "$ALLOWED_GITHUB_USERS" '
  {
    GITHUB_CLIENT_ID:     { type: "plain_text",  value: $id },
    GITHUB_CLIENT_SECRET: { type: "secret_text", value: $secret },
    SESSION_SECRET:       { type: "secret_text", value: $session },
    ALLOWED_GITHUB_USERS: { type: "plain_text",  value: $users }
  } as $vars
  | { deployment_configs: {
      production: { env_vars: $vars },
      preview:    { env_vars: $vars }
    } }')

RESP=$(curl -sS -X PATCH \
  -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  -H "Content-Type: application/json" \
  "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$CLOUDFLARE_PAGES_PROJECT" \
  -d "$PAYLOAD")

if [[ "$(jq -r .success <<<"$RESP")" != "true" ]]; then
  echo >&2 "Error updating Pages project env vars:"
  jq >&2 . <<<"$RESP"
  exit 1
fi

echo "Production env vars now set:"
jq -r '.result.deployment_configs.production.env_vars | keys[] | "  " + .' <<<"$RESP"

echo "Done. Push to main (or re-run the Deploy workflow) for the new values to take effect."
