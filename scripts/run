#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}: line $LINENO: $BASH_COMMAND: exitcode $?"' ERR
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.."

echo >&2 "Starting Zola dev server ..."
echo >&2 "Open http://127.0.0.1:1111  (Spanish at /es/, CMS at /admin)"
zola --root site serve "$@"
