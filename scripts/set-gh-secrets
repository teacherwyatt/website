#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}: line $LINENO: $BASH_COMMAND: exitcode $?"' ERR
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v gh &>/dev/null ; then
  echo >&2 "Error: gh tool not installed; run brew install gh"
  exit 1
fi

ENV_FILE="$SCRIPT_DIR/../.env"
if [[ ! -f "$ENV_FILE" ]]; then
  echo >&2 "Error: $ENV_FILE not found"
  exit 1
fi

# Target the repo behind `origin` explicitly. Left to itself, gh guesses from
# the remotes, but it can't see through SSH host aliases like
# git@github-teacherwyatt:owner/repo.git and would pick the backup remote.
ORIGIN_URL="$(git -C "$SCRIPT_DIR/.." remote get-url origin)"
REPO="$(sed -E 's#^.*[:/]([^/:]+/[^/]+)$#\1#' <<<"${ORIGIN_URL%.git}")"
echo "Setting secrets on GitHub repo: $REPO"

# Only the deploy workflow's secrets. The rest of .env (OAuth secret, etc.)
# belongs in the Pages project (scripts/setup-secrets), not GitHub, and
# GitHub rejects secret names starting with GITHUB_ anyway.
CI_SECRETS=(CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID)

while IFS='=' read -r key value || [[ -n "$key" ]]; do
  # Skip comments and blank lines
  [[ "$key" =~ ^[[:space:]]*# ]] && continue
  [[ -z "$key" ]] && continue
  [[ " ${CI_SECRETS[*]} " == *" $key "* ]] || continue

  # Strip inline comments and surrounding whitespace/quotes from value
  value="${value%%#*}"
  value="${value#"${value%%[! ]*}"}"
  value="${value%"${value##*[! ]}"}"
  value="${value#\'}" value="${value%\'}"
  value="${value#\"}" value="${value%\"}"

  echo "Setting secret: $key"
  gh secret set "$key" --repo "$REPO" --body "$value"
done < "$ENV_FILE"

echo "Done."
