#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo >&2 "${BASH_SOURCE[0]}: line $LINENO: $BASH_COMMAND: exitcode $?"' ERR
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.."

echo >&2 "Installing build tools ..."
TOOLS=(actionlint direnv fswatch git git-lfs htmltest jq node pnpm python zola)
for tool in "${TOOLS[@]}"; do
    command -v "$tool" &>/dev/null || brew install "$tool"
done

echo >&2 "Installing wrangler ..."
command -v wrangler &>/dev/null || pnpm add -g wrangler

