# Cloudflare API (used by scripts/setup-pages-project, scripts/setup-secrets,
# and the CI deploy via scripts/set-gh-secrets).
# Token needs: Account:Cloudflare Pages:Edit
#              Cloudflare One / Zero Trust > Access: Edit (scripts/setup-cloudflare-access;
#              older dashboards call it "Access: Apps and Policies")
# Later, with a custom domain, scripts/setup-apex-redirect additionally needs:
#              Zone:Zone:Read, Zone:Config Rules:Edit
# (The "Config Rules" scope is what Cloudflare calls the permission that
#  covers Dynamic Redirects; on some accounts it's labeled "Transform Rules".)
# Zone-level scopes should target the site's zone specifically, not All Zones.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=teacherwyatt

# GitHub OAuth App for the CMS login (scripts/setup-secrets copies these
# into the Pages project).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign into /admin
ALLOWED_GITHUB_USERS=teacherwyatt

# Cloudflare Access (scripts/setup-cloudflare-access): comma-separated emails
# allowed to view *.teacherwyatt.pages.dev while the site is private
ACCESS_ALLOWED_EMAILS=

# Only needed later, with a custom domain:
# CLOUDFLARE_ZONE_ID=
